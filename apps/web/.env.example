# --- Supabase (https://supabase.com/dashboard → Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public URL of this app (used for the Google OAuth redirect) ---
APP_URL=http://localhost:3000

# --- 32 random bytes, base64. Encrypts connector tokens. Generate: openssl rand -base64 32 ---
ENCRYPTION_KEY=

# --- Model. "<provider>:<model id>". Set the key for whichever provider you use. ---
FLUENT_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Google OAuth client (Gmail + Sheets). Redirect URI: ${APP_URL}/api/connectors/google/callback ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Background sync ---
# Bearer secret for GET /api/cron/sync (safety net, every 15 min with Pub/Sub; Vercel Hobby only allows daily crons, so use an external scheduler there)
CRON_SECRET=
# Gmail push (primary real-time path). Topic: projects/<id>/topics/<name>; push subscription URL: <APP_URL>/api/webhooks/gmail?token=GMAIL_PUSH_TOKEN
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_TOKEN=
