# --- Supabase (https://supabase.com/dashboard → Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public URL of this app (used for the Google OAuth redirect) ---
APP_URL=http://localhost:3000

# --- 32 random bytes, base64. Encrypts connector tokens. Generate: openssl rand -base64 32 ---
ENCRYPTION_KEY=

# --- Model. "<provider>:<model id>". Set the key for whichever provider you use. ---
FLUENT_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Google OAuth client (Gmail + Sheets). Redirect URI: ${APP_URL}/api/connectors/google/callback ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
